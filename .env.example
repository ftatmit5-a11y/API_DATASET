# Copy to .env and adjust. docker compose reads .env automatically.
# (.env is git-ignored on purpose; never commit real secrets or local paths.)

# Host port that maps to the container's 8080.
PORT=8080

# Upload ceiling enforced by the server, in mebibytes.
MAX_UPLOAD_MB=512

# Labels written into the built image.
VERSION=dev
COMMIT=unknown
SOURCE_REPO=local/yoloapi
